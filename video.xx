<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>My Website</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #111;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 {
      font-size: 30px;
    }

    nav {
      margin-top: 15px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
    }

    .hero {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px;
      background: linear-gradient(135deg, #111, #444);
      color: white;
    }

    .hero h2 {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      margin-bottom: 25px;
    }

    .button {
      display: inline-block;
      padding: 14px 25px;
      background: white;
      color: #111;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    .section {
      padding: 50px 20px;
      text-align: center;
    }

    .cards {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .card {
      background: white;
      width: 280px;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .card h3 {
      margin-bottom: 12px;
    }

    footer {
      background: #111;
      color: white;
      text-align: center;
      padding: 25px;
    }
  </style>
</head>

<body>

  <header>
    <h1>My Website</h1>

    <nav>
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero" id="home">
    <div>
      <h2>Welcome to My Website</h2>
      <p>This is my new website.</p>
      <a href="#about" class="button">Explore</a>
    </div>
  </section>

  <section class="section" id="about">
    <h2>About Me</h2>
    <p style="margin-top:15px;">
      Welcome! This is my personal website where I can share
      information, projects and services.
    </p>
  </section>

  <section class="section" id="services">
    <h2>My Services</h2>

    <div class="cards">

      <div class="card">
        <h3>Service 1</h3>
        <p>Describe your first service here.</p>
      </div>

      <div class="card">
        <h3>Service 2</h3>
        <p>Describe your second service here.</p>
      </div>

      <div class="card">
        <h3>Service 3</h3>
        <p>Describe your third service here.</p>
      </div>

    </div>
  </section>

  <section class="section" id="contact">
    <h2>Contact</h2>
    <p style="margin-top:15px;">
      Email: your@email.com
    </p>
  </section>

  <footer>
    <p>© 2026 My Website. All rights reserved.</p>
  </footer>

</body>
</html>
